<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sadece oynatma sırasında ekranı/kilidi açık tutmak için, pil dostu -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".IPTVApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="IPTV Player Pro"
        android:theme="@style/Theme.IPTVPlayer"
        android:banner="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.IPTVPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.HomeActivity" android:exported="false" />

        <activity
            android:name=".ui.RemotePairingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:launchMode="singleTop" />

    </application>
</manifest>
